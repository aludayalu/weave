{
  "name": "maikalal-desktop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "electron": "electron .",
    "electron:dev": "CHAT_WORKSPACE=$PWD electron .",
    "electron:package": "bun run build && electron-builder --mac --dir"
  },
  "dependencies": {
    "@heroui/react": "^3.2.3",
    "@heroui/styles": "^3.2.3",
    "@openrouter/sdk": "^1.2.83",
    "@streamdown/code": "^1.1.1",
    "exa-js": "^2.16.3",
    "fast-deep-equal": "^3.1.3",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "streamdown": "^2.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "babel-plugin-react-compiler": "1.0.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "main": "electron/main.js",
  "build": {
    "appId": "com.maikalal.desktop",
    "productName": "Maikalal",
    "files": [
      "electron/**/*",
      "app/**/*",
      "components/**/*",
      "lib/**/*",
      "public/**/*",
      "next.config.mjs",
      "postcss.config.mjs",
      "globals.css",
      "package.json",
      ".next/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dir"
      ]
    }
  }
}