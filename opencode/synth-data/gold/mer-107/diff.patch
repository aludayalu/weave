diff --git a/internal/config/task107_optional_config_test.go b/internal/config/task107_optional_config_test.go
new file mode 100644
index 0000000..834d2e5
--- /dev/null
+++ b/internal/config/task107_optional_config_test.go
@@ -0,0 +1,38 @@
+package config
+
+import (
+	"reflect"
+	"testing"
+)
+
+// MER-107: self-hosted installs distinguish "not configured" from an
+// explicitly configured empty callback URL. Migration guarantees decide
+// which config fields are values and which are optional pointers.
+func TestPartnerWebhookUsesOptionalPointerConvention(t *testing.T) {
+	f, ok := reflect.TypeOf(Config{}).FieldByName("PartnerWebhookURL")
+	if !ok { t.Fatal("PartnerWebhookURL missing") }
+	if f.Type.Kind() != reflect.Ptr { t.Errorf("optional runtime setting has type %s; want pointer", f.Type) }
+}
+
+func TestPartnerWebhookUnsetIsNil(t *testing.T) {
+	c := Config{}
+	v := reflect.ValueOf(c.PartnerWebhookURL)
+	if v.Kind() != reflect.Ptr || !v.IsNil() { t.Errorf("zero config should represent unset, got %#v", c.PartnerWebhookURL) }
+}
+
+func TestGuaranteedFieldsRemainValues(t *testing.T) {
+	typ := reflect.TypeOf(Config{})
+	for _, name := range []string{"DBPoolSize", "HTTPTimeout", "AuditRetainDays"} {
+		f, _ := typ.FieldByName(name)
+		if f.Type.Kind() == reflect.Ptr { t.Errorf("migration-guaranteed %s unexpectedly optional", name) }
+	}
+}
+
+func TestEnvOverrideSetsOptionalValue(t *testing.T) {
+	t.Setenv("MERIDIAN_PARTNER_WEBHOOK_URL", "https://partner.example.test/hook")
+	c := Load()
+	v := reflect.ValueOf(c.PartnerWebhookURL)
+	if v.Kind() != reflect.Ptr || v.IsNil() || v.Elem().String() != "https://partner.example.test/hook" {
+		t.Errorf("env override not represented as set optional: %#v", c.PartnerWebhookURL)
+	}
+}