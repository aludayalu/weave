@@ -0,0 +1,31 @@
+package jobs
+
+import (
+	"context"
+	"testing"
+)
+
+func TestTenantContextRoundTrips(t *testing.T) {
+	ctx := WithTenant(context.Background(), "harborline")
+	if got := TenantFrom(ctx); got != "harborline" { t.Fatalf("tenant=%q", got) }
+}
+
+func TestAsyncExportCarriesRouteTenant(t *testing.T) {
+	r := NewRunner()
+	seen := make(chan string, 1)
+	done, err := r.StartTenant("export:harborline:inv-7", "harborline", func(ctx context.Context, cancel <-chan struct{}) error {
+		seen <- TenantFrom(ctx)
+		return nil
+	})
+	if err != nil { t.Fatal(err) }
+	if err := <-done; err != nil { t.Fatal(err) }
+	if got := <-seen; got != "harborline" { t.Errorf("worker tenant=%q; must preserve route tenant", got) }
+}
+
+func TestTenantScopedJobsDoNotShareIdentity(t *testing.T) {
+	if previewID("harborline", "inv-7") == previewID("vantage", "inv-7") { t.Fatal("tenant must be part of stable job id") }
+}
+
+func TestTenantFromMissingIsEmpty(t *testing.T) {
+	if got := TenantFrom(context.Background()); got != "" { t.Errorf("got %q", got) }
+}
