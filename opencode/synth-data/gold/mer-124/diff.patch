+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { getBootstrap, flagEnabled } from "./bootstrap.ts";
+import { readFileSync } from "node:fs";
+import { fileURLToPath } from "node:url";
+
+function withWindow<T>(opts: { server?: any; storage?: any }, fn: () => T): T {
+  const g = globalThis as any;
+  const prevWindow = g.window;
+  const prevLocalStorage = g.localStorage;
+  g.window = { __MERIDIAN__: opts.server, localStorage: opts.storage ?? { getItem: () => null } };
+  g.localStorage = g.window.localStorage;
+  try { return fn(); } finally { g.window = prevWindow; g.localStorage = prevLocalStorage; }
+}
+
+test("authenticated render uses server blob, never localStorage", () => {
+  withWindow({
+    server: { flags: { "tenant.switch.v2": "on" }, version: "9" },
+    storage: { getItem: () => JSON.stringify({ flags: { "tenant.switch.v2": "off" }, version: "stale" }) },
+  }, () => {
+    assert.equal(flagEnabled("tenant.switch.v2"), true);
+    assert.equal(getBootstrap().version, "9");
+  });
+});
+
+test("authenticated sessions never consult localStorage, even for absent flags", () => {
+  let reads = 0;
+  withWindow({
+    server: { flags: {}, version: "9" },
+    storage: { getItem: () => { reads++; return JSON.stringify({ flags: { "audit.stream.v2": "on" }, version: "stale" }); } },
+  }, () => {
+    assert.equal(flagEnabled("audit.stream.v2"), false, "stale local flag leaked into an authenticated session");
+  });
+  assert.equal(reads, 0, "authenticated sessions must not consult localStorage");
+});
+
+test("server blob is authoritative even when empty", () => {
+  withWindow({ server: { flags: { "audit.stream.v2": "off" }, version: "9" }, storage: { getItem: () => JSON.stringify({ flags: { "audit.stream.v2": "on" }, version: "stale" }) } }, () => {
+    assert.equal(getBootstrap().version, "9");
+    assert.equal(flagEnabled("audit.stream.v2"), false);
+  });
+});
+
+test("logged-out visitors still fall back to localStorage", () => {
+  withWindow({ storage: { getItem: () => JSON.stringify({ flags: { "audit.stream.v2": "on" }, version: "cached" }) } }, () => {
+    assert.equal(flagEnabled("audit.stream.v2"), true);
+    assert.equal(getBootstrap().version, "cached");
+  });
+});
+
+test("no server blob and no cache yields empty bootstrap", () => {
+  withWindow({}, () => {
+    assert.deepEqual(getBootstrap(), { flags: {}, version: "0" });
+  });
+});
+
+test("app shell gates tenant policy on the server bootstrap, not post-mount state", () => {
+  const src = readFileSync(fileURLToPath(new URL("../pages/_app.tsx", import.meta.url)), "utf8");
+  assert.doesNotMatch(src, /useEffect\([\s\S]*setPolicyReady\(true\)/, "policy gate must not wait for a post-mount effect");
+  assert.doesNotMatch(src, /policyReady/);
+});
