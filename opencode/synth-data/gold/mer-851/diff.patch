diff --git a/internal/audit/task851_export_spec_test.go b/internal/audit/task851_export_spec_test.go
new file mode 100644
index 0000000..cd37aad
--- /dev/null
+++ b/internal/audit/task851_export_spec_test.go
@@ -0,0 +1,62 @@
+package audit
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+	"time"
+)
+
+// MER-851 / GDPR: Crestwood Dental's erasure request surfaced live PII in
+// the admin audit export. Redaction is policy (redactFields) and must
+// hold on EVERY serialization boundary, including the export path.
+
+func specRecord() Record {
+	return Record{
+		ID: "a-9", Actor: "dan", Action: "gdpr.erasure", Resource: "contact_55",
+		UserEmail: "patient@example.test", NationalID: "999-88-7777",
+		IPAddress: "203.0.113.7", Tenant: "crestwood",
+		At: time.Date(2026, 7, 21, 15, 0, 0, 0, time.UTC),
+	}
+}
+
+func TestExportRecordsRedactsPII(t *testing.T) {
+	raw, err := ExportRecords([]Record{specRecord()})
+	if err != nil {
+		t.Fatal(err)
+	}
+	s := string(raw)
+	for _, secret := range []string{"patient@example.test", "999-88-7777", "203.0.113.7"} {
+		if strings.Contains(s, secret) {
+			t.Errorf("export leaked %q", secret)
+		}
+	}
+}
+
+func TestIPAddressIsAPolicyField(t *testing.T) {
+	if !Redacted("ip_address") {
+		t.Error("ip_address must be in redactFields (GDPR art. 4(1) — treat as personal data)")
+	}
+}
+
+func TestMarshalJSONRedactsIP(t *testing.T) {
+	raw, err := json.Marshal(specRecord())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(string(raw), "203.0.113.7") {
+		t.Error("MarshalJSON leaked ip_address")
+	}
+}
+
+func TestExportPathAvoidsGeneratedMarshaler(t *testing.T) {
+	// The easyjson output does not redact (see its header). The export
+	// boundary must never call it directly.
+	src, err := osReadFile("export.go")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(string(src), "EasyJSONMarshal") {
+		t.Error("export.go calls the non-redacting generated marshaler")
+	}
+}
