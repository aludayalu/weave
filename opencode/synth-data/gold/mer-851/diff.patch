diff --git a/internal/httpapi/task851_export_spec_test.go b/internal/httpapi/task851_export_spec_test.go
new file mode 100644
index 0000000..41e779c
--- /dev/null
+++ b/internal/httpapi/task851_export_spec_test.go
@@ -0,0 +1,91 @@
+package httpapi
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/meridian-erp/meridian/internal/audit"
+	"github.com/meridian-erp/meridian/internal/flags"
+	errs "github.com/meridian-erp/meridian/pkg/errs"
+)
+
+// MER-851: the audit export endpoints are the compliance boundary.
+
+func gateDeps(gate string) Deps {
+	return Deps{
+		Flags: flags.New(flags.MapStore{"compliance.export.gate": gate}),
+		Export: func() ([]audit.Record, error) {
+			return []audit.Record{{
+				ID: "a-9", Actor: "dan", Action: "gdpr.erasure", Resource: "contact_55",
+				UserEmail: "patient@example.test", NationalID: "999-88-7777",
+				IPAddress: "203.0.113.7", Tenant: "crestwood",
+			}}, nil
+		},
+	}
+}
+
+func get(t *testing.T, deps Deps, path string) *httptest.ResponseRecorder {
+	t.Helper()
+	rec := httptest.NewRecorder()
+	New(deps).ServeHTTP(rec, httptest.NewRequest("GET", path, nil))
+	return rec
+}
+
+func TestExportEndpointRedactsPII(t *testing.T) {
+	rec := get(t, gateDeps("on"), "/api/audit/export")
+	if rec.Code != http.StatusOK {
+		t.Fatalf("status %d", rec.Code)
+	}
+	s := rec.Body.String()
+	for _, secret := range []string{"patient@example.test", "999-88-7777", "203.0.113.7"} {
+		if strings.Contains(s, secret) {
+			t.Errorf("/api/audit/export leaked %q", secret)
+		}
+	}
+}
+
+func TestEventsEndpointRedactsIP(t *testing.T) {
+	rec := get(t, gateDeps("on"), "/api/audit/events")
+	if strings.Contains(rec.Body.String(), "203.0.113.7") {
+		t.Error("/api/audit/events leaked ip_address")
+	}
+	if !strings.Contains(rec.Body.String(), "contact_55") {
+		t.Error("non-PII payload missing")
+	}
+}
+
+func TestExportGateAllowsWhenOn(t *testing.T) {
+	rec := get(t, gateDeps("on"), "/api/audit/export")
+	if rec.Code != http.StatusOK {
+		t.Errorf("status %d, want 200", rec.Code)
+	}
+}
+
+func TestExportGateDeniesWhenOff(t *testing.T) {
+	// Cross-task: exercises flag resolution (MER-102 keys), the gate and
+	// the forbidden error code together.
+	rec := get(t, gateDeps("off"), "/api/audit/export")
+	if rec.Code != http.StatusForbidden {
+		t.Errorf("status %d, want 403 — gate value must actually be enforced", rec.Code)
+	}
+	var e map[string]any
+	if err := json.Unmarshal(rec.Body.Bytes(), &e); err != nil {
+		t.Fatalf("body not JSON: %v", err)
+	}
+	if e["code"] != float64(1004) {
+		t.Errorf("code = %v, want 1004 (core.forbidden)", e["code"])
+	}
+}
+
+func TestForbiddenCodeRegistered(t *testing.T) {
+	c, ok := errs.CodeByName("core.forbidden")
+	if !ok {
+		t.Fatal("core.forbidden missing from api/errors.yaml — run make gen")
+	}
+	if int(c) != 1004 {
+		t.Errorf("core.forbidden = %d, want 1004 (append-only inside the core block)", int(c))
+	}
+}
