+package store
+
+import (
+	"testing"
+
+	"github.com/meridian-erp/meridian/internal/flags"
+)
+
+// MER-103: import jobs accept the historical underscore form, while the
+// tenant_overrides table is seeded in dotted lowercase form. A fallback
+// to the tenant default changes invoice due dates for specific customers.
+func TestOverrideKeyCanonicalForms(t *testing.T) {
+	cases := map[string]string{
+		"billing.grace_period_days":      "billing.grace_period_days",
+		"BILLING.GRACE_PERIOD_DAYS":      "billing.grace_period_days",
+		"BILLING_Grace_Period_Days":      "billing.grace_period_days",
+		" Billing.grace_period_days ":    "billing.grace_period_days",
+	}
+	for input, want := range cases {
+		if got := OverrideKey(input); got != want {
+			t.Errorf("OverrideKey(%q) = %q, want %q", input, got, want)
+		}
+	}
+}
+
+func TestSeededOverrideResolvesLegacyImport(t *testing.T) {
+	seed := map[string]string{"billing.grace_period_days": "7"}
+	legacyImportKey := "BILLING_Grace_Period_Days"
+	if got := seed[OverrideKey(legacyImportKey)]; got != "7" {
+		t.Errorf("legacy import resolved to %q; expected seeded seven-day override", got)
+	}
+}
+
+func TestOverrideLookupDoesNotRewritePropertyUnderscores(t *testing.T) {
+	got := OverrideKey("billing.grace_period_days")
+	if got != "billing.grace_period_days" {
+		t.Fatalf("property separator was altered: %q", got)
+	}
+}
+
+func TestOverrideKeyIsIdempotent(t *testing.T) {
+	first := OverrideKey("BILLING_Grace_Period_Days")
+	if second := OverrideKey(first); second != first {
+		t.Errorf("normalization is not idempotent: %q -> %q", first, second)
+	}
+}
+
+func TestFlagAndTenantOverrideDialectsRemainDistinct(t *testing.T) {
+	// Cross-task contract: feature flags normalize all separators to dots,
+	// while tenant override aliases only map the legacy first separator.
+	if got := flags.New(flags.MapStore{"compliance.export.gate": "on"}).Get(flags.FlagComplianceExportGate); got != "on" {
+		t.Fatalf("flag lookup regression: %q", got)
+	}
+	if got := OverrideKey("billing.grace_period_days"); got != "billing.grace_period_days" {
+		t.Fatalf("override dialect changed: %q", got)
+	}
+}