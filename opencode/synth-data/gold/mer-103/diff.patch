@@ -49,5 +49,14 @@ func escape(s string) string {
 // migrations/0002_seed_tenants.sql — check that file before changing how
 // keys are normalized here.
 func OverrideKey(key string) string {
-	return strings.ToLower(key)
+	k := strings.ToLower(strings.TrimSpace(key))
+	// Legacy import files used one underscore between namespace and field
+	// (BILLING_Grace_Period_Days). Underscores inside the field name are
+	// significant: only the first separator becomes a dot.
+	if !strings.Contains(k, ".") {
+		if i := strings.IndexByte(k, '_'); i >= 0 {
+			k = k[:i] + "." + k[i+1:]
+		}
+	}
+	return k
 }
