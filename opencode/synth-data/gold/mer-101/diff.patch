diff --git a/pkg/errs/task101_gateway_timeout_test.go b/pkg/errs/task101_gateway_timeout_test.go
new file mode 100644
index 0000000..bc2a8c6
--- /dev/null
+++ b/pkg/errs/task101_gateway_timeout_test.go
@@ -0,0 +1,79 @@
+package errs
+
+import (
+	"os"
+	"strings"
+	"testing"
+)
+
+// MER-101: Harborline Logistics maps our payment errors by numeric code in
+// their WMS integration. They need a distinct code for upstream PSP
+// timeouts so their retry logic can tell "retry later" from "declined".
+// Per the pinned note, new codes are APPEND-ONLY inside the module block.
+
+func TestGatewayTimeoutCodeResolvesByName(t *testing.T) {
+	c, ok := CodeByName("payment.gateway_timeout")
+	if !ok {
+		t.Fatal("payment.gateway_timeout not registered — add it to api/errors.yaml and run `make gen`")
+	}
+	if int(c) != 3003 {
+		t.Errorf("payment.gateway_timeout = %d, want 3003 (append after rate_limited)", int(c))
+	}
+}
+
+func TestGatewayTimeoutMessage(t *testing.T) {
+	got := Message(Code(3003))
+	if got != "payment gateway timeout" {
+		t.Errorf("Message(3003) = %q, want %q", got, "payment gateway timeout")
+	}
+}
+
+func TestGatewayTimeoutAppendedAfterExistingPaymentCodes(t *testing.T) {
+	raw, err := os.ReadFile("../../api/errors.yaml")
+	if err != nil {
+		t.Fatal(err)
+	}
+	s := string(raw)
+	iRate := strings.Index(s, "- name: rate_limited")
+	iGW := strings.Index(s, "- name: gateway_timeout")
+	if iGW < 0 {
+		t.Fatal("api/errors.yaml missing payment.gateway_timeout")
+	}
+	if iRate < 0 || iGW < iRate {
+		t.Error("gateway_timeout must be appended AFTER rate_limited (append-only rule)")
+	}
+}
+
+func TestGatewayTimeoutInGeneratedTS(t *testing.T) {
+	raw, err := os.ReadFile("../../web/lib/errcodes_gen.ts")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(string(raw), `"gateway_timeout": 3003`) {
+		t.Error("web/lib/errcodes_gen.ts stale - run make gen")
+	}
+}
+
+func TestGatewayTimeoutNamedConstant(t *testing.T) {
+	raw, err := os.ReadFile("code.go")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(string(raw), "CodePaymentGatewayTimeout") {
+		t.Error("code.go must expose a named constant CodePaymentGatewayTimeout")
+	}
+}
+
+func TestExistingPaymentCodesUnchanged(t *testing.T) {
+	// Guard: whatever you did, the codes Harborline already ships must not move.
+	for name, want := range map[string]int{
+		"payment.declined":     3000,
+		"payment.expired":      3001,
+		"payment.rate_limited": 3002,
+	} {
+		c, ok := CodeByName(name)
+		if !ok || int(c) != want {
+			t.Errorf("%s = %d (ok=%v), want %d", name, c, ok, want)
+		}
+	}
+}
