diff --git a/web/embed_contract_test.go b/web/embed_contract_test.go
new file mode 100644
index 0000000..a878237
--- /dev/null
+++ b/web/embed_contract_test.go
@@ -0,0 +1,35 @@
+package web
+
+import (
+	"io"
+	"os"
+	"strings"
+	"testing"
+)
+
+func TestEmbeddedBundleContainsEntrypoint(t *testing.T) {
+	f, err := Dist.Open("dist/index.html")
+	if err != nil { t.Fatal("compiled server must embed web/dist", err) }
+	defer f.Close()
+	b, err := io.ReadAll(f); if err != nil { t.Fatal(err) }
+	if !strings.Contains(string(b), "Meridian ERP") { t.Error("embedded entrypoint is not the console") }
+}
+
+func TestDockerBuildsWebBeforeGoEmbed(t *testing.T) {
+	b, err := os.ReadFile("../Dockerfile"); if err != nil { t.Fatal(err) }
+	s := string(b)
+	webStage := strings.Index(s, "FROM node:")
+	webBuild := strings.Index(s, "npm run build")
+	goStage := strings.Index(s, "FROM golang:")
+	if webStage < 0 || webBuild < webStage || goStage < 0 || webBuild > goStage {
+		t.Error("Docker must build web/dist in a Node stage before the Go embed build")
+	}
+}
+
+func TestDockerCopiesFreshDistIntoGoBuildContext(t *testing.T) {
+	b, err := os.ReadFile("../Dockerfile"); if err != nil { t.Fatal(err) }
+	s := string(b)
+	if !strings.Contains(s, "--from=webbuild") || !strings.Contains(s, "web/dist") {
+		t.Error("Go build stage is not using the freshly built frontend bundle")
+	}
+}