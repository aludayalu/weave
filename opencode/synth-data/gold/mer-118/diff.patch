@@ -0,0 +1,29 @@
+package billing
+
+import (
+	"testing"
+	"github.com/meridian-erp/meridian/internal/store"
+)
+
+func TestSummaryCacheKeyContainsTenant(t *testing.T) {
+	got:=SummaryCacheKey("harborline")
+	if got!="inv:totals:harborline" { t.Errorf("summary key=%q",got) }
+}
+
+func TestTwoTenantsCannotShareSummaryKey(t *testing.T) {
+	a:=SummaryCacheKey("harborline"); b:=SummaryCacheKey("vantage")
+	if a==b { t.Fatalf("cross-tenant cache collision on %q",a) }
+}
+
+func TestSummaryKeyUsesSharedStoreConvention(t *testing.T) {
+	if got:=SummaryCacheKey("crestwood");got!=store.CacheKey("inv","totals","crestwood") { t.Errorf("key=%q",got) }
+}
+
+func TestLegacyKeyIsStillReadableButNotWritten(t *testing.T) {
+	if SummaryCacheKey("harborline")==store.LegacyKey("inv","totals") { t.Fatal("new writes must not use two-segment legacy key") }
+	if store.IsLegacyKey(store.LegacyKey("inv","totals"))=="" { t.Fatal("legacy decoder must still recognize old key") }
+}
+
+func TestEmptyTenantDoesNotAliasLegacySummary(t *testing.T) {
+	if SummaryCacheKey("")==store.LegacyKey("inv","totals") { t.Fatal("empty tenant must not map to legacy key") }
+}