diff --git a/internal/validation/task120_draft_validation_test.go b/internal/validation/task120_draft_validation_test.go
new file mode 100644
index 0000000..3e8ff24
--- /dev/null
+++ b/internal/validation/task120_draft_validation_test.go
@@ -0,0 +1,30 @@
+package validation
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestEmptyDraftCanAutosave(t *testing.T) {
+	if err:=ValidateDraft(PurchaseOrder{}); err!=nil { t.Errorf("incomplete draft rejected by autosave: %v",err) }
+}
+
+func TestDraftCanSaveWithOnlyVendor(t *testing.T) {
+	if err:=ValidateDraft(PurchaseOrder{VendorID:"v-12"}); err!=nil { t.Errorf("draft missing due date rejected: %v",err) }
+}
+
+func TestSubmitStillRequiresVendorAndDate(t *testing.T) {
+	for _,po:=range []PurchaseOrder{{},{VendorID:"v-12"},{DueDate:"2026-12-01"}} {
+		if err:=ValidateSubmit(po); err==nil { t.Errorf("invalid submit accepted: %+v",po) }
+	}
+}
+
+func TestValidSubmitPasses(t *testing.T) {
+	if err:=ValidateSubmit(PurchaseOrder{VendorID:"v-12",DueDate:"2026-12-01",Memo:"annual supplies"});err!=nil { t.Fatal(err) }
+}
+
+func TestDraftAndSubmitReturnFieldSpecificErrorsOnlyAtSubmit(t *testing.T) {
+	err:=ValidateSubmit(PurchaseOrder{})
+	if err==nil || !strings.Contains(err.Error(),"vendor_id") { t.Errorf("submit error=%v",err) }
+	if ValidateDraft(PurchaseOrder{})!=nil { t.Error("autosave should not surface submit-time field errors") }
+}
