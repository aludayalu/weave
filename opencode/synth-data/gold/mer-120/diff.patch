diff --git a/web/lib/task120_schema_mode.test.ts b/web/lib/task120_schema_mode.test.ts
new file mode 100644
index 0000000..78b0065
--- /dev/null
+++ b/web/lib/task120_schema_mode.test.ts
@@ -0,0 +1,17 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { validatePurchaseOrder } from "./schemas.ts";
+
+test("client autosave accepts incomplete draft", () => {
+  assert.deepEqual(validatePurchaseOrder({}, "draft"), []);
+});
+test("client submit requires vendor and date", () => {
+  const issues=validatePurchaseOrder({},"submit");
+  assert.deepEqual(issues.map(x=>x.field).sort(),["due_date","memo","vendor_id"]);
+});
+test("draft mode does not require submit-only memo", () => {
+  assert.deepEqual(validatePurchaseOrder({vendor_id:"v-1"},"draft"),[]);
+});
+test("valid submit passes client validation", () => {
+  assert.deepEqual(validatePurchaseOrder({vendor_id:"v-1",due_date:"2026-12-01",memo:"stock"},"submit"),[]);
+});