diff --git a/web/lib/task104_tenant_switch.test.ts b/web/lib/task104_tenant_switch.test.ts
new file mode 100644
index 0000000..cb371e1
--- /dev/null
+++ b/web/lib/task104_tenant_switch.test.ts
@@ -0,0 +1,48 @@
+/**
+ * MER-104 spec: Vantage Foods saw Harborline invoice counts after
+ * switching workspaces. Derived-data caches must never outlive the
+ * tenant that produced them, and the hook must subscribe to the store
+ * (SSR snapshot contract) instead of polling local state.
+ */
+import { test, beforeEach } from "node:test";
+import assert from "node:assert/strict";
+import {
+  getTenant,
+  switchTenant,
+  cachedFor,
+  _testReset,
+} from "./tenantStore.ts";
+import { readFileSync } from "node:fs";
+import { fileURLToPath } from "node:url";
+
+beforeEach(() => _testReset());
+
+test("tenant switch invalidates derived-data caches", () => {
+  cachedFor("invoiceTotals", () => "A-TOTAL");
+  switchTenant("vantage");
+  const v = cachedFor("invoiceTotals", () => "B-TOTAL");
+  assert.equal(
+    v,
+    "B-TOTAL",
+    "stale cache from previous tenant served after switch (MER-104)"
+  );
+});
+
+test("recomputed values observe the new tenant id", () => {
+  const a = getTenant().id;
+  cachedFor(`${a}:counts`, () => "A-COUNTS");
+  switchTenant("crestwood");
+  const b = getTenant().id;
+  assert.notEqual(a, b);
+  assert.equal(cachedFor(`${b}:counts`, () => "B-COUNTS"), "B-COUNTS");
+});
+
+test("useTenant subscribes via useSyncExternalStore, never polls", () => {
+  const src = readFileSync(
+    fileURLToPath(new URL("../hooks/useTenant.ts", import.meta.url)),
+    "utf8"
+  );
+  assert.match(src, /useSyncExternalStore/);
+  assert.doesNotMatch(src, /setInterval/);
+  assert.doesNotMatch(src, /useState<Tenant>/);
+});
