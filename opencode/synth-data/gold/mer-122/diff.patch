diff --git a/web/lib/task122_error_fallback.test.ts b/web/lib/task122_error_fallback.test.ts
new file mode 100644
index 0000000..732e149
--- /dev/null
+++ b/web/lib/task122_error_fallback.test.ts
@@ -0,0 +1,27 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { messageFor } from "./errMessages.ts";
+import { ERR_MESSAGES } from "./errcodes_gen.ts";
+
+test("new gateway timeout has a message for each supported locale", () => {
+  for (const locale of ["en","de","fr"] as const) {
+    assert.equal(messageFor(3003,locale),"payment gateway timeout");
+  }
+});
+
+test("every generated code has a non-empty locale fallback", () => {
+  for (const code of Object.keys(ERR_MESSAGES).map(Number)) {
+    for (const locale of ["en","de","fr"] as const) {
+      assert.ok(messageFor(code,locale),`missing ${locale} fallback for ${code}`);
+    }
+  }
+});
+
+test("hand-translated message takes precedence over generated English", () => {
+  assert.equal(messageFor(1000,"de"),"Ressource nicht gefunden.");
+  assert.equal(messageFor(1000,"fr"),"Ressource introuvable.");
+});
+
+test("unknown numeric codes remain undefined for caller fallback", () => {
+  assert.equal(messageFor(987654,"de"),undefined);
+});