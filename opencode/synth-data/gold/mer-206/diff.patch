@@ -3,9 +3,18 @@ package payments
 
 import "fmt"
 
-// AttemptKey identifies one ledger attempt. RetryNumber is included in
-// the key today; gateway retries within one attempt should actually reuse
-// the same key (MER-206).
-func AttemptKey(invoiceID string, attempt int, retryNumber int) string {
-	return fmt.Sprintf("invoice:%s:attempt:%d:retry:%d", invoiceID, attempt, retryNumber)
+// AttemptKey identifies one ledger attempt.
+//
+// The ledger reconciler groups charges on the attempt key (see
+// internal/payments/ledger.go), so a key MUST stay stable for every
+// retry of the SAME attempt. A new attempt — a new authorization after a
+// provider-declined charge — gets a new key (MER-206).
+func AttemptKey(invoiceID string, attempt int) string {
+	return fmt.Sprintf("invoice:%s:attempt:%d", invoiceID, attempt)
 }
+
+// RetryKey is what a worker must send for a retry of the current attempt.
+func RetryKey(invoiceID string, attempt int) string { return AttemptKey(invoiceID, attempt) }
+
+// NextAttemptKey is used only after a failed attempt is written to the ledger.
+func NextAttemptKey(invoiceID string, attempt int) string { return AttemptKey(invoiceID, attempt+1) }
diff --git a/internal/payments/ledger.go b/internal/payments/ledger.go
new file mode 100644
index 0000000..fd392a7
--- /dev/null
+++ b/internal/payments/ledger.go
@@ -0,0 +1,11 @@
+package payments
+
+// Ledger is the write-ahead record the gateway reconciler replays. Charge
+// rows are keyed by the idempotency key that was sent to the provider.
+type Ledger struct{ rows map[string]int }
+
+func NewLedger() *Ledger { return &Ledger{rows: map[string]int{}} }
+
+func (l *Ledger) Record(key string) { l.rows[key]++ }
+
+func (l *Ledger) Count(key string) int { return l.rows[key] }