--- a/web/lib/sseAuth.ts
+++ b/web/lib/sseAuth.ts
@@ -13,5 +13,12 @@ export interface SSECredentials {
 
 export function authorizeSSE(profile: SSEProfile, credentials: SSECredentials): boolean {
   if (credentials.sessionCookie) return true;
-  return false; // query-token fallback is restored for the legacy server in MER-203
+  if (profile === "legacy") return isUsableQueryToken(credentials.queryToken);
+  return false; // app-router SSE requires the session cookie
+}
+
+/** Legacy EventSource tokens are short lived and issued by the pages server. */
+export function isUsableQueryToken(token?: string): boolean {
+  if (!token) return false;
+  return /^[A-Za-z0-9_-]{16,}$/.test(token) && !token.includes("guest");
 }