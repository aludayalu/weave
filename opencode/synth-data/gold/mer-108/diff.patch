+package events
+
+import (
+	"encoding/json"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func TestCorrelationIDTagsAgreeAcrossDecoders(t *testing.T) {
+	f, _ := reflect.TypeOf(WireEvent{}).FieldByName("CorrelationID")
+	if got := f.Tag.Get("json"); got != "correlation_id" { t.Fatalf("json tag=%q", got) }
+	if got := f.Tag.Get("mapstructure"); got != "correlation_id" { t.Errorf("mapstructure tag=%q; persisted row decoder loses correlation id", got) }
+}
+
+func TestCorrelationIDSurvivesJSONPersistence(t *testing.T) {
+	raw, err := json.Marshal(WireEvent{ID:"evt-7", Type:"invoice.updated", CorrelationID:"corr-77"})
+	if err != nil { t.Fatal(err) }
+	if !strings.Contains(string(raw), `"correlation_id":"corr-77"`) { t.Errorf("payload=%s", raw) }
+}
+
+func TestOldPayloadWithoutCorrelationStillDecodes(t *testing.T) {
+	var e WireEvent
+	if err := json.Unmarshal([]byte(`{"id":"old","type":"invoice.updated","tenant":"vantage"}`), &e); err != nil { t.Fatal(err) }
+	if e.ID != "old" || e.CorrelationID != "" { t.Errorf("legacy decode=%+v", e) }
+}
+
+func TestNewPayloadKeepsTenantAndAttempts(t *testing.T) {
+	raw, _ := json.Marshal(WireEvent{ID:"x", Tenant:"crestwood", CorrelationID:"c", Attempts:2})
+	var got map[string]any
+	if err := json.Unmarshal(raw,&got); err != nil { t.Fatal(err) }
+	if got["tenant"] != "crestwood" || got["attempts"] != float64(2) { t.Errorf("payload=%v", got) }
+}