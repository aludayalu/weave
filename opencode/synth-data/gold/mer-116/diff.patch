diff --git a/internal/ratelimit/task116_tenant_limit_test.go b/internal/ratelimit/task116_tenant_limit_test.go
new file mode 100644
index 0000000..59258b6
--- /dev/null
+++ b/internal/ratelimit/task116_tenant_limit_test.go
@@ -0,0 +1,33 @@
+package ratelimit
+
+import (
+	"os"
+	"strings"
+	"testing"
+
+	"github.com/meridian-erp/meridian/internal/store"
+)
+
+func TestTenantExportPolicyExistsInAllEnforcers(t *testing.T) {
+	if _, ok := DefaultLimits["export.tenant"]; !ok { t.Error("Go limiter missing export.tenant") }
+	yaml, err := os.ReadFile("../../configs/ratelimits.yaml"); if err != nil { t.Fatal(err) }
+	nginx, err := os.ReadFile("../../deploy/nginx.conf"); if err != nil { t.Fatal(err) }
+	if !strings.Contains(string(yaml), "export.tenant") { t.Error("policy YAML missing export.tenant") }
+	if !strings.Contains(string(nginx), "export_tenant") { t.Error("nginx has no tenant export bucket") }
+}
+
+func TestTenantExportRateMatchesAcrossLayers(t *testing.T) {
+	lim, ok := DefaultLimits["export.tenant"]
+	if !ok { t.Fatal("policy not in Go") }
+	if lim.PerSecond != 2 || lim.Burst != 4 { t.Errorf("Go policy=%+v, want 2/s burst4",lim) }
+	nginx, _ := os.ReadFile("../../deploy/nginx.conf")
+	if !strings.Contains(string(nginx), "rate=2r/s burst=4") { t.Error("nginx rate differs from tenant export policy") }
+}
+
+func TestTenantExportCacheKeysRemainIsolated(t *testing.T) {
+	if store.CacheKey("audit","export","harborline")==store.CacheKey("audit","export","vantage") { t.Fatal("tenant export cache keys collide") }
+}
+
+func TestLegacyAuditExportLimitUnaffected(t *testing.T) {
+	if got:=DefaultLimits["export.audit"]; got!=(Limit{PerSecond:1,Burst:3}) { t.Errorf("legacy audit policy changed: %+v",got) }
+}