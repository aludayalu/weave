diff --git a/internal/flags/task102_flag_keys_test.go b/internal/flags/task102_flag_keys_test.go
new file mode 100644
index 0000000..080b384
--- /dev/null
+++ b/internal/flags/task102_flag_keys_test.go
@@ -0,0 +1,55 @@
+package flags
+
+import "testing"
+
+// MER-102: the compliance export flag silently no-ops for tenants whose
+// row was seeded by ops (migrations/0003 writes dotted keys; the Go
+// registry reads kebab-case). Three spellings exist in the wild — the
+// canonical form is whatever the seed script wrote.
+
+func TestSeededDottedFlagResolves(t *testing.T) {
+	f := New(MapStore{"compliance.export.gate": "on"})
+	if got := f.Get(FlagComplianceExportGate); got != "on" {
+		t.Errorf("Get(%q) = %q, want %q — seeded row must resolve", FlagComplianceExportGate, got, "on")
+	}
+}
+
+func TestCanonicalKeyUnifiesSpellings(t *testing.T) {
+	a := canonicalKey("compliance-export-gate") // Go registry
+	b := canonicalKey("compliance.export.gate")  // SQL seed (canonical)
+	c := canonicalKey("Compliance_Export_Gate")  // ops console export
+	if a != b || b != c {
+		t.Errorf("spellings disagree: %q vs %q vs %q", a, b, c)
+	}
+}
+
+func TestWatchListCoversComplianceFlag(t *testing.T) {
+	f := New(MapStore{})
+	for _, w := range f.watched {
+		if w == FlagComplianceExportGate {
+			return
+		}
+	}
+	t.Error("compliance-export-gate missing from watch list — Set() will leave a stale cache")
+}
+
+func TestSetInvalidatesCachedComplianceFlag(t *testing.T) {
+	f := New(MapStore{"compliance.export.gate": "on"})
+	f.Get(FlagComplianceExportGate) // warm the cache with the seeded row
+	f.Set("compliance.export.gate", "off")
+	if got := f.Get(FlagComplianceExportGate); got != "off" {
+		t.Errorf("after Set, Get = %q, want %q (stale cache)", got, "off")
+	}
+}
+
+func TestEnvOverrideStillWorksForComplianceFlag(t *testing.T) {
+	restore := osGetenv
+	t.Cleanup(func() { osGetenv = restore })
+	vals := map[string]string{"FLAGS_COMPLIANCE_EXPORT_GATE": "staging"}
+	osGetenv = func(n string) string { return vals[n] }
+
+	f := New(MapStore{})
+	if got := f.Get(FlagComplianceExportGate); got != "staging" {
+		t.Errorf("Get = %q, want staging", got)
+	}
+}
