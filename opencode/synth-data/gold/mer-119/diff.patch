diff --git a/web/lib/task119_pagination_key.test.ts b/web/lib/task119_pagination_key.test.ts
new file mode 100644
index 0000000..ed7d564
--- /dev/null
+++ b/web/lib/task119_pagination_key.test.ts
@@ -0,0 +1,30 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import { fileURLToPath } from "node:url";
+import { swrKeys } from "./swrKeys.ts";
+
+const invoiceKey = swrKeys.invoices as unknown as (tenant: string, page: number) => string;
+
+test("invoice list key includes tenant and page", () => {
+  assert.equal(invoiceKey("harborline", 2), "billing:invoices:harborline:p2");
+});
+
+test("same page for two tenants never shares cache key", () => {
+  assert.notEqual(invoiceKey("harborline", 1), invoiceKey("vantage", 1));
+});
+
+test("same tenant pages have distinct keys", () => {
+  assert.notEqual(invoiceKey("crestwood", 1), invoiceKey("crestwood", 2));
+});
+
+test("invoice page consumes generated key instead of local literal", () => {
+  const src = readFileSync(fileURLToPath(new URL("../pages/invoices.tsx", import.meta.url)), "utf8");
+  assert.match(src, /swrKeys\.invoices\(tenant\.id,\s*page\)/);
+  assert.doesNotMatch(src, /const listKey = `billing:invoices:/);
+});
+
+test("generated key source declares tenant and page dimensions", () => {
+  const routes = readFileSync(fileURLToPath(new URL("../routes.yaml", import.meta.url)), "utf8");
+  assert.match(routes, /billing:invoices:\{tenant\}:p\{page\}/);
+});
