# =====================================================================
# Lakebase credentials for this dataset. NEVER commit this file.
# It is gitignored. Fill in ONE of the two shapes below.
# =====================================================================

# ---- Shape A (preferred): Databricks SDK, short-lived token ----------
# The SDK asks Lakebase to mint a short-lived password for the instance,
# so there is no long-lived database password lying around.
# Create the instance in the workspace UI (see README), then:
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
LAKEBASE_INSTANCE=meridian-tribal
DATABRICKS_TOKEN=          # from Databricks auth profile: `databricks auth login`

# ---- Shape B: a plain Postgres DSN -----------------------------------
# Copy the connection string from the Lakebase instance page in the UI.
# Leave blank if you are using Shape A.
LAKEBASE_DSN=
# e.g. postgresql://meridian_app:••••••••@abc-12345.psql.databricks.com:5432/meridian?sslmode=require

# ---- loading knobs (optional) ----------------------------------------
# Store document bytes in the row instead of object pointers: 1 = yes
INLINE_DOCS=0
# Only load these stages: bronze,silver,detected,gold
STAGES=bronze,silver,detected,gold
